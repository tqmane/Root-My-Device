# Copy these exports into your shell or a private, ignored local file.
# Never commit real paths or passwords.
export ANDROID_HOME="$HOME/Android/Sdk"
export ANDROID_NDK_HOME="$ANDROID_HOME/ndk/29.0.14206865"

# Optional one-key shorthand used by tools/build-all.sh.
export ROOT_MY_DEVICE_KEYSTORE=/absolute/path/release-signing.p12
export ROOT_MY_DEVICE_KEY_ALIAS=key0
export ROOT_MY_DEVICE_STORE_PASSWORD='replace-me'
export ROOT_MY_DEVICE_KEY_PASSWORD='replace-me'

# Then run:
# ./tools/build-all.sh --release
